{
  "rewrites": [
    { "source": "/go/:slug", "destination": "/api/go-redirect?slug=:slug" },
    { "source": "/((?!api/)(?!.*\\.).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/metricool-analytics",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/calendar-sync",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/client-reports",
      "schedule": "0 13 * * *"
    }
  ]
}
